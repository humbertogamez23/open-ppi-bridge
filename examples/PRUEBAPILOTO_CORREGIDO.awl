ORGANIZATION_BLOCK Bloque_de_programa:OB1
TITLE=COMENTARIOS DEL PROGRAMA
BEGIN
Network 1 
LD     SM0.0
CALL   SBR2
Network 2 // Marcha / Paro (Fisico I0.0 / I0.1 y App V200.0 / V200.1)
LD     I0.0
O      V200.0
LD     M0.0
OLD
A      I0.1
AN     V200.1
AN     T101
=      M0.0
Network 3 // Parada Temporizada (Fisico I0.3 o Parada App V200.1)
LD     I0.3
O      V200.1
O      M0.1
AN     T101
=      M0.1
Network 4 
LD     M0.1
TON    T101, 300
Network 5 
LD     M0.0
CALL   SBR0
Network 6 
LD     Q0.2
AN     Q0.4
TON    T63, VW102
Network 7 
LD     T63
O      Q0.4
AN     M0.1
=      Q0.4
Network 8 
LD     Q0.4
CALL   SBR1
Network 9 // Auto-reset de pulsadores de la App (Seguridad contra perdida de enlace)
LD     V200.0
R      V200.0, 1
LD     V200.1
R      V200.1, 1
END_ORGANIZATION_BLOCK
SUBROUTINE_BLOCK SBR_0:SBR0
TITLE=ARRANQUE ESTRELLA DELTA
BEGIN
Network 1 // Arranque Contactor de Línea Principal
LD     SM0.0
=      Q0.0
Network 2 // Temporizador Estrella (Base 100ms)
LD     Q0.0
AN     Q0.2
TON    T37, VW100
Network 3 // Contactor Estrella
LD     Q0.0
AN     Q0.2
AN     T37
=      Q0.1
Network 4 // Pausa de Transición Estrella -> Delta (Base 10ms, 60 ticks = 600ms)
LD     Q0.0
A      T37
AN     Q0.2
TON    T33, 60
Network 5 // Contactor Delta con auto-retención
LD     T33
LD     Q0.0
A      Q0.2
OLD
=      Q0.2
END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK SBR_1:SBR1
TITLE=COMENTARIOS DE LA SUBRUTINA
BEGIN
Network 1 
END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK SBR_2:SBR2
TITLE=LECTURA Y CLAMPING DE POTENCIOMETROS
BEGIN
Network 1 
LD     SM0.0
MOVW   0, AC0
Network 2 
LD     SM0.0
MOVB   SMB28, AC0
Network 3 
LD     SM0.0
MOVW   AC0, VW100
Network 4 // Piso mínimo 15 ticks
LDW<=  VW100, 15
MOVW   15, VW100
Network 5 // Techo máximo 195 ticks
LDW>=  VW100, 195
MOVW   195, VW100
Network 6 
LD     SM0.0
MOVW   0, AC1
Network 7 
LD     SM0.0
MOVB   SMB29, AC1
Network 8 
LD     SM0.0
MOVW   AC1, VW102
Network 9 // Piso mínimo 15 ticks
LDW<=  VW102, 15
MOVW   15, VW102
Network 10 // Techo máximo 195 ticks
LDW>=  VW102, 195
MOVW   195, VW102
END_SUBROUTINE_BLOCK
INTERRUPT_BLOCK INT_0:INT0
TITLE=COMENTARIOS DE LA RUTINA DE INTERRUPCION
BEGIN
Network 1 
END_INTERRUPT_BLOCK
