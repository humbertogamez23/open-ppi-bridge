# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.bak
*.v8.bak

# Log files
*.log
*.log.*
logs/

# Unix Sockets & System
*.sock
.DS_Store

# Virtual Machine Disks & ISOs
*.qcow2
*.iso
*.img
*.vmdk

# Flutter / Android build artifacts
app/**/build/
app/**/.dart_tool/
app/**/.idea/
app/**/*.iml
app/**/android/.gradle/
app/**/android/local.properties

# ESP-IDF firmware build artifacts
firmware/**/build/
firmware/**/managed_components/
firmware/**/sdkconfig
firmware/**/sdkconfig.old
